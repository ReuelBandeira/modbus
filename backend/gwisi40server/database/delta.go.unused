func initializeDeviceConfiguration() {
	var device models.DeviceConfiguration
	var memory models.Memories
	var deviceId uint
	var memoryId uint

	DB.First(&device, "manufacturer = ? AND serie = ?", "DELTA", "AS300")
	if device.ID != 0 {
		return
	}

	var dev = models.DeviceConfiguration{Manufacturer: "DELTA", Serie: "AS300"}
	DB.Create(&dev)

	deviceId = dev.ID

	DB.First(&device, "manufacturer = ? AND serie = ?", "DELTA", "AS300")

	memory = models.Memories{DeviceID: deviceId, Label: "X", Type: "BIT", Format: "DECIMAL"}
	DB.Create(&memory)
	memoryId = memory.ID
	DB.Limit(1).First(&memory, "label = ? AND type = ? AND format = ?", "X", "BIT", "DECIMAL")

